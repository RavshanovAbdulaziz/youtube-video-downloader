# Nusxa oling: cp .env.example .env — va haqiqiy qiymatlarni to'ldiring.
# .env fayli git'ga hech qachon qo'shilmasligi kerak (.gitignore'da bor).

# @BotFather'dan olingan Telegram bot tokeni.
BOT_TOKEN=

# Web UI'ning ochiq manzili (CORS uchun). Masalan: http://123.45.67.89
# Bo'sh qoldirilsa barcha originlar ruxsat etiladi (lokal companion rejimida
# kerak bo'ladi, lekin serverda o'zingizning manzilingizni yozing).
PUBLIC_ORIGIN=*

# Ushbu hajmdan (MB) katta fayllarni bot Telegram orqali yubormaydi.
MAX_TELEGRAM_MB=49

# Fayl juda katta bo'lganda botning xabarida ko'rsatiladigan Web UI manzili.
WEB_UI_URL=

# Ixtiyoriy: telegram-bot-api'ning lokal (--local) serveri ishga tushirilgan
# bo'lsa, uning manzili — 50MB o'rniga 2000MB'gacha fayl yuborish imkonini
# beradi. Bo'sh qoldirilsa standart Telegram Bot API (50MB chegara) ishlatiladi.
LOCAL_API_BASE_URL=
