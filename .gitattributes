# Windows'ning cmd.exe skriptlari CRLF qator oxirlarini TALAB qiladi. LF
# bilan saqlansa, `if ... (` kabi ko'p qatorli bloklar noto'g'ri o'qiladi va
# `REM` izohlari buyruq sifatida bajarilishga urinadi (natijada
# "'Dasturni' is not recognized as an internal or external command" kabi
# tushunarsiz xatolar chiqadi).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Qolgan matnli fayllar odatdagidek (repo ichida LF).
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf

# Binar fayllar — hech qanday o'zgartirishsiz.
*.ico binary
*.png binary
*.jpg binary
*.mp4 binary
*.mp3 binary
